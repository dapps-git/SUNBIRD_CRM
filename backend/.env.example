PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sunbird_crm?retryWrites=true&w=majority
JWT_SECRET=your_super_strong_jwt_secret_token_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5174

# Initial Admin Credentials (used during automatic seed/sync)
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@sunbirdsolar.com
# Admin password MUST be stored as a bcrypt hash ($2a$10$...) - plaintext is NEVER saved in .env
INITIAL_ADMIN_PASSWORD_HASH=$2a$10$G3ApqGIj9Xyg0JHLq1V1AenPbZbvlBm2MHAHovCW/LSsbV5bHNo2u

# Email & SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sunbird Solar CRM" <noreply@sunbirdsolar.com>

# Cloudinary Settings (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
